{
  "name": "@trixdb/client",
  "version": "0.6.0",
  "description": "Official TypeScript SDK for Trix - A memory and knowledge management API",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "require": "./dist/testing/index.js",
      "import": "./dist/testing/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc src/index.ts --out docs --plugin typedoc-plugin-markdown",
    "prepublishOnly": "npm run build",
    "prepare": "lefthook install"
  },
  "keywords": [
    "trix",
    "memory",
    "knowledge",
    "graph",
    "semantic-search",
    "typescript",
    "sdk"
  ],
  "author": "Trix",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://trixdb.com/support",
    "email": "support@trixdb.com"
  },
  "homepage": "https://trixdb.com",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "lefthook": "^2.0.13",
    "ts-jest": "^29.4.6",
    "tsup": "^8.0.1",
    "typedoc": "^0.28.0",
    "typedoc-plugin-markdown": "^4.0.0",
    "typescript": "^5.3.3"
  }
}
