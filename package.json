{
  "name": "trixdb",
  "version": "1.0.0",
  "description": "Official TypeScript SDK for TrixDB - A memory and knowledge management API",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    },
    "./testing": {
      "require": "./dist/testing/index.js",
      "import": "./dist/testing/index.mjs",
      "types": "./dist/testing/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc src/index.ts --out docs --plugin typedoc-plugin-markdown",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "trixdb",
    "memory",
    "knowledge",
    "graph",
    "semantic-search",
    "typescript",
    "sdk"
  ],
  "author": "TrixDB",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/trixdb/trix-typescript-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/trixdb/trix-typescript-sdk/issues"
  },
  "homepage": "https://github.com/trixdb/trix-typescript-sdk#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.6",
    "tsup": "^8.0.1",
    "typedoc": "^0.26.0",
    "typedoc-plugin-markdown": "^4.0.0",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  }
}
